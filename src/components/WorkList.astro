---
import { getCollection } from 'astro:content';

const posts = (await getCollection('work')).toSorted(
    (a, b) => a.data.order - b.data.order,
);
---

{posts.map((post) => (
    <article class="entry">
        <h3>
            <a href={`/work/${post.id}`}>{post.data.title}</a>
        </h3>
        <p class="meta">{post.data.summary}</p>
    </article>
))}

<article class="entry">
    <h3>
        <a href="/writing/2020-software-overview.pdf">
            20|20 Software Overview
        </a>
    </h3>
    <p class="meta">
        A guide I wrote to help growers understand how their in-cab display
        thinks. (PDF)
    </p>
</article>
